{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "isolatedModules": false,
        "resolveJsonModule": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "useDefineForClassFields": false,
        "types": ["mocha", "node"],
        "baseUrl": "..",
        "paths": {
            "$lib": ["."]
        }
    },
    "include": ["*.ts", "**/*.ts"]
}
